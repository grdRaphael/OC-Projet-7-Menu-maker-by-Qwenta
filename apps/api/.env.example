# VARIABLES D'ENVIRONNEMENT DU SERVEUR (liste des réglages, sans secret réel).
#
# En développement, AUCUN fichier n'est nécessaire : les valeurs ci-dessous
# sont déjà celles utilisées par défaut. Pour en changer une, copier ce fichier
# en « .env » (ignoré par Git) et modifier la ligne voulue.
# En production, chaque valeur doit être fournie par l'hébergeur.

NODE_ENV=development
API_PORT=3100

# Base PostgreSQL locale (Docker, compose.yaml). Identifiants de développement uniquement.
DATABASE_URL=postgres://menumaker:dev-menumaker@127.0.0.1:5442/menumaker
TEST_DATABASE_URL=postgres://menumaker:dev-menumaker@127.0.0.1:5442/menumaker_test
